# =============================================================================
# FOH Environment Configuration
# =============================================================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control!

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=foh_database
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme_secure_password_here

# API Configuration
API_PORT=8000

# Frontend Configuration
FRONTEND_PORT=8080

# CORS Configuration (add your Hostgator domain)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://your-domain.com

# Synology NAS Configuration (for reference)
# NAS_IP=192.168.1.100
# NAS_SSH_PORT=22
# NAS_USER=admin

# Hostgator Configuration (for reference)
# HOSTGATOR_DOMAIN=your-domain.com
# HOSTGATOR_FTP_HOST=ftp.your-domain.com
# HOSTGATOR_FTP_USER=your-username

# Optional: Production Settings
# ENVIRONMENT=production
# LOG_LEVEL=info
# ENABLE_HTTPS=true
